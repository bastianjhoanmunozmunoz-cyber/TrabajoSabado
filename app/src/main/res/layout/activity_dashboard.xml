<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_light" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="18dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/primary">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bodega" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E2EDF3" android:textSize="14sp" android:paddingTop="6dp" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Operación" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="6dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnInventory" android:layout_width="match_parent" android:layout_height="56dp" android:text="Productos e inventario" android:textAlignment="viewStart" android:textSize="15sp" app:cornerRadius="12dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnMovements" android:layout_width="match_parent" android:layout_height="56dp" android:text="Entradas y salidas" android:textAlignment="viewStart" android:textSize="15sp" android:layout_marginTop="8dp" app:cornerRadius="12dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnCategories" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Consultar categorías" android:textAlignment="viewStart" android:textSize="14sp" android:layout_marginTop="8dp" app:cornerRadius="12dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cuenta" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="6dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnAdmin" android:layout_width="match_parent" android:layout_height="52dp" android:text="Administración" android:textAlignment="viewStart" android:textSize="14sp" android:layout_marginTop="2dp" app:cornerRadius="12dp" app:backgroundTint="@color/teal_soft" android:textColor="@color/primary" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePassword" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="Cambiar contraseña" android:layout_marginTop="8dp" app:cornerRadius="12dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Cerrar sesión" android:textColor="@color/btn_delete" android:layout_marginTop="4dp" />
 </LinearLayout>
</ScrollView>
