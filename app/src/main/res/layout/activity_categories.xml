<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_light" android:padding="18dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categorías" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary" android:paddingBottom="12dp" />
 <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="@color/border_soft" app:strokeWidth="1dp">
  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
   <ListView android:id="@+id/listActiveCategories" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@color/border_soft" android:dividerHeight="1dp" android:padding="8dp" />
   <TextView android:id="@+id/tvNoCategories" android:layout_width="match_parent" android:layout_height="match_parent" android:text="No hay categorías activas." android:textColor="@color/text_secondary" android:gravity="center" android:visibility="gone" />
  </FrameLayout>
 </com.google.android.material.card.MaterialCardView>
</LinearLayout>
